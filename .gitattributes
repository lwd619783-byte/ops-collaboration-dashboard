# Normalize repository text files and keep working-tree text as LF.
* text=auto eol=lf

# The authoritative V1.3 plan uses Markdown two-space hard line breaks.
docs/project-construction-plan-v1.3.md whitespace=-trailing-space

# Windows command scripts retain CRLF when introduced later.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary assets must never be line-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
